# Settings of Build/Scripts/runTests.sh for this package
PACKAGE_NAME="kaystrobach/dyncss_scss"
TEST_NAMESPACE='KayStrobach\DyncssScss\Tests\'
SUPPORTED_VERSIONS="12 13 14"
CORE_PACKAGES="core backend extbase fluid frontend install"
DATABASE=sqlite

# dyncss: the clone next to this one (e.g. vendor/kaystrobach/dyncss), otherwise its branch on GitHub
DYNCSS_PATH="${DYNCSS_PATH:-$(cd "${EXTENSION_ROOT}/.." && pwd)/dyncss}"
if [ -f "${DYNCSS_PATH}/composer.json" ]; then
    EXTRA_DOCKER_VOLUMES="-v ${DYNCSS_PATH}:/dependencies/dyncss"
    EXTRA_REPOSITORIES=('{"type": "path", "url": "/dependencies/dyncss", "options": {"symlink": true, "versions": {"kaystrobach/dyncss": "1.99.0"}}}')
    EXTRA_REQUIRE=()
else
    EXTRA_REPOSITORIES=('{"type": "vcs", "url": "https://github.com/kaystrobach/TYPO3.dyncss"}')
    EXTRA_REQUIRE=('"kaystrobach/dyncss": "dev-typo3-12-13-14 as 1.99.0"')
fi

# SCSSPHP=2 Build/Scripts/runTests.sh: with scssphp 2.x instead of 1.x
if [ "${SCSSPHP:-1}" = "2" ]; then
    EXTRA_REQUIRE+=('"scssphp/scssphp": "^2.0"')
    BUILD_SUFFIX="-scssphp2"
fi
